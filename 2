#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

int main() {
    double x;
    int n;

    cout << "Введіть дійсне число x: ";
    cin >> x;
    cout << "Введіть натуральне число n: ";
    cin >> n;

    if (n <= 0) {
        cout << "Помилка: n має бути натуральним числом." << endl;
        return 1;
    }

    double y = 0.0;
    double current_x_power = 1.0; // зберігатиме x^1, x^2, ..., x^n

    for (int k = 1; k <= n; ++k) {
        current_x_power *= x;
        y += sin(current_x_power);
    }

    cout << fixed << setprecision(6);
    cout << "Значення виразу y = " << y << endl;
    return 0;
}
